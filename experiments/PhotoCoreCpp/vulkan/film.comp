    } else if (work.op == 7) {
        vec3 need = demand(px.rgb, b[i].rgb, vec3(c[i].r), p[0]);
        float usage = 1.6 * dot(need, vec3(1.0 / 3));
        vec3 uptake = need * min(1, c[i].r / max(usage, 1e-7));
        result = vec4(max(b[i].rgb - uptake, vec3(0)), 1);
        dst2[i] = vec4(vec3(max(0, c[i].r - 1.6 * dot(uptake, vec3(1.0 / 3)))), 1);
    } else if (work.op == 8) {
        float delta = 0, total = p[1];
        for (int k = 1; k <= int(p[0]); ++k) {
            ivec2 d = work.axis == 0 ? ivec2(k, 0) : ivec2(0, k);
            delta += p[1 + k] *
                     ((sampleA(ivec2(x, y) - d).r - px.r) + (sampleA(ivec2(x, y) + d).r - px.r));
            total += 2 * p[1 + k];
        }
        result = vec4(vec3(px.r + delta / total), 1);
    } else if (work.op == 9) {
        result = vec4(vec3(clamp(px.r, 0, 1) * (1 - p[0]) + p[0]), 1);
    } else if (work.op == 10) {
        int fw = int(p[4]), fh = int(p[5]);
        vec2 q = vec2((x + .5) * p[0] - .5, float(fh) - (float(work.height) - y - .5) * p[0] - .5);
        vec3 activityField = bilinear(0, q, fw, fh), salt = bilinear(1, q, fw, fh), rs = vec3(1),
             rd = vec3(1);
        for (int k = 0; k < 12; ++k) {
            vec3 need = demand(activityField, rs, rd, p[2]),
                 uptake = need * min(vec3(1), rd / max(1.6 * need, vec3(1e-7)));
            rs = max(rs - uptake, vec3(0));
            vec3 ref = max(rd - 1.6 * uptake, vec3(0));
            rd = ref + (1 - ref) * p[3];
        }
        vec3 rel = (max(1 - salt, vec3(0)) + .0001) / (max(1 - rs, vec3(0)) + .0001);
        result = vec4(px.rgb * exp(clamp(log(rel), vec3(-.7), vec3(.7)) * p[1]), px.a);
    } else if (work.op == 11) {
        float d = chemDensity(chemExposure(dot(straight(px), EW))) * px.a;
        result = vec4(vec3(d), px.a);
    } else if (work.op == 12) {
        if (px.a <= 0)
            result = vec4(0);
        else {
            vec3 color = straight(px);
            float lum = dot(color, EW);
            if (lum > 1e-10) {
                float ex = chemExposure(lum), d = chemDensity(ex);
                if (p[5] > 0) {
                    float delta = d - b[i].r / max(b[i].a, 1e-10);
                    d += p[5] * delta / (1 + abs(delta) / .08);
                }
                if (p[4] > 0)
                    d += p[4] * chemNoise(vec2(x + .5 + p[11], float(work.height) - y - .5 + p[12]));
                float t = clamp((d - .08) / 2.4, .00001, .99999),
                      inverse = log(t / (1 - t)) / (4 * .65 / 2.4),
                      target = .18 * exp(clamp(inverse * LN10, -60, 25));
                target = lum * clamp(target / lum, .015625, 64);
                vec3 v = labLum(color, lum, target / lum);
                if (p[7] == 0 && dot(abs(pv(8)), vec3(1)) > 0) {
                    v *= exp(clamp(ex, -3, 2) * pv(8) * LN10);
                    float cy = dot(v, EW);
                    if (cy <= target * .0001) {
                        v += target - cy;
                        cy = target;
                    }
                    v *= target / cy;
                    float lower = min(0, min(color.r, min(color.g, color.b))) * target / lum,
                          minimum = min(v.r, min(v.g, v.b));
                    if (minimum < lower)
                        v = target +
                            (v - target) * clamp((target - lower) / (target - minimum), 0, 1);
                }
                result = vec4((color + (v - color) * p[3]) * px.a, px.a);
            }
        }
    } else if (work.op == 13) {
        result = spectral(px, i);
    } else if (work.op == 14) {
        if (px.a <= 0)
            result = vec4(0);
        else {
            vec3 v = mul(0, straight(px));
            if (p[9] != 0)
                v = vec3(dot(v, W));
            result = vec4(v * px.a, px.a);
        }
    } else if (work.op == 15) {
        result.rgb *= pv(0);
    } else if (work.op == 16) {
        if (px.a <= 0)
            result = vec4(0);
        else {
            vec3 color = max(straight(px), vec3(0));
            float before = dot(color, W), lum = before;
            if (lum > 0 && lum < 1 && p[0] != 1) {
                float z = p[0] * (log(lum / (1 - lum)) - log(.18 / .82)) + log(.18 / .82);
                lum = 1 / (1 + exp(-clamp(z, -80, 80)));
            }
            color = before > 1e-12 ? color * (lum / before) : vec3(lum);
            if (p[6] != 0)
                result = vec4(vec3(lum) * px.a, px.a);
            else {
                float warm = smoothGate(-.25, .25, (color.r - color.b) / max(.02, lum));
                color = fit(lum + (color - lum) * (p[3] + (p[2] - p[3]) * warm), lum);
                float shadows = smoothGate(0, .012, lum) * (1 - smoothGate(.025, .18, lum)),
                      high = smoothGate(.25, .70, lum) * (1 - smoothGate(.85, 1, lum)),
                      mid = smoothGate(.025, .18, lum) * (1 - smoothGate(.3, .65, lum));
                color *= exp(vec3(.35, .10, -.4) * (p[4] * shadows + p[5] * high + p[1] * mid) *
                             log(2.0));
                color *= lum / max(1e-12, dot(color, W));
                result = vec4(fit(color, lum) * px.a, px.a);
            }
        }
    } else if (work.op == 17) {
        vec3 v = (px.rgb / max(px.a, 1e-6) + p[3]) / (1 + p[3]);
        v = grade(v, p[0], p[1], p[2], pv(4), false);
        if (p[7] != 0)
            v = vec3(dot(v, W));
        result = vec4(v * px.a, px.a);
    } else if (work.op == 19) {
        // 與 CIColorMatrix alpha + CISourceOverCompositing 相同的預乘混合。
        vec4 foreground = b[i] * p[0];
        result = foreground + px * (1 - foreground.a);
    } else if (work.op == 20) {
        // CIColorControls saturation=0 的線性工作空間係數。
        result = vec4(vec3(dot(px.rgb, vec3(.2125, .7154, .0721))), px.a);
    } else if (work.op == 18) {
        vec3 v = clamp(px.rgb, vec3(0), vec3(1));
        for (int j = 0; j < 3; ++j) {
            float s = v[j] <= .0031308 ? 12.92 * v[j] : 1.055 * pow(v[j], 1 / 2.4) - .055;
            s = floor(s * 65535 + .5) / 65535;
            v[j] = s <= .04045 ? s / 12.92 : pow((s + .055) / 1.055, 2.4);
        }
        result = vec4(v, 1);
    }
    dst[i] = result;
}
